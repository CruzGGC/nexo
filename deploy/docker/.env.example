# App
NODE_ENV=production
PORT=3000
APP_PORT=3000
APP_BASE_URL=https://play.cruz-home.win

# PocketBase (server-side — internal Docker network)
POCKETBASE_URL=http://pocketbase:8090
PB_VERSION=0.36.5
PB_GOMEMLIMIT=256MiB

# PocketBase (client-side — public URL)
PUBLIC_POCKETBASE_URL=https://play.cruz-home.win/api

# PocketBase admin bootstrap (if your app/scripts use it)
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=change-me

# Backup
BACKUP_RETENTION_DAYS=14

# Score proof signing (set a long random value in production)
SCORE_PROOF_SECRET=change-this-to-a-long-random-secret
